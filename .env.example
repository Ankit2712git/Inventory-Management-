# =============================================================================
# Bangla Haat Environment Variables Template
# Copy this file to .env for local deployment.
# NEVER commit .env with real credentials to GitHub.
# =============================================================================

# Server-Side Email Integration (Optional: Used by server.js to forward customer messages)
RESEND_API_KEY=

# Server-Side Admin Authorization (Optional: Protects /api/messages retrieval)
ADMIN_API_KEY=

# Admin Email Whitelist (Optional: Comma-separated emails that get Admin role upon login)
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Supabase Live Synchronization (Optional: If omitted, runs in resilient local storage mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=

